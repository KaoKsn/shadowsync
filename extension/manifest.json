{
  "manifest_version": 3,
  "name": "PrivSight",
  "version": "1.0",
  "description": "Scans and maps interactive elements for LLM payloads.",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "trigger-capture-and-hints": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "Capture DOM and screenshot to for LLM agent"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "face_detection_yunet_2023mar.onnx",
        "ort.wasm.min.js",
        "*.mjs",
        "*.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "html2canvas.min.js",
        "redactor.js",
        "ort.wasm.min.js",
        "faceRedaction.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
