{
  "manifest_version": 3,
  "name": "PrivSight",
  "version": "2.0.0",
  "description": "Privacy-preserving browser agent. Keeps your data safe while AI works on your behalf.",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "options_page": "profile/profile.html",
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open PrivSight",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "match_about_blank": true,
      "js": [
        "content/html2canvas.min.js",
        "content/redactor.js",
        "content/ort.wasm.min.js",
        "content/faceRedaction.js",
        "content/qrMask.js",
        "content/pii-config.js",
        "content/pii-autofill.js",
        "content/agent.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "face_detection_yunet_2023mar.onnx",
        "ort-wasm-simd-threaded.wasm",
        "ort-wasm-simd-threaded.mjs",
        "content/ort.wasm.min.js",
        "*.mjs",
        "*.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
