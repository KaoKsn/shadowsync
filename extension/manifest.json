{
  "manifest_version": 3,
  "name": "PrivSight",
  "version": "2.0.0",
  "description": "Privacy-preserving browser agent. Keeps your data safe while AI works on your behalf.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open PrivSight"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "html2canvas.min.js",
        "redactor.js",
        "ort.wasm.min.js",
        "faceRedaction.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "face_detection_yunet_2023mar.onnx",
        "ort.wasm.min.js",
        "*.mjs",
        "*.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
