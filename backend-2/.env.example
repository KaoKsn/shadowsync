LLM_PROVIDER=openai            # openai | ollama
OPENAI_API_KEY=
# LLM_BASE_URL=                # override endpoint (defaults: OpenAI, or $OLLAMA_BASE_URL/v1)
OLLAMA_BASE_URL=http://localhost:11434

# Per-role models (required). Ollama example: ACTOR_MODEL=llava, PLANNER_MODEL=READER_MODEL=llama3.1
# Actor: picks actions, sees screenshots when requested (needs vision + tool calling)
ACTOR_MODEL=gpt-4.1-mini
# Planner: plans once + replans when stuck (text only)
PLANNER_MODEL=gpt-4.1-mini
# Reader: distils page text into notes/answers (text only)
READER_MODEL=gpt-4.1-mini

# Output limits (a reply cut at the limit is lost) and per-request timeout
ACTOR_MAX_TOKENS=400
PLANNER_MAX_TOKENS=350
READER_MAX_TOKENS=500
LLM_TIMEOUT_SECONDS=45

# Only these WebSocket origins may use the agent (comma-separated). Empty =
# any chrome-extension:// origin; web pages are always refused.
# ALLOWED_ORIGINS=chrome-extension://<your-extension-id>

# Budgets
MAX_TOTAL_STEPS=30
MAX_SCREENSHOTS=6
MAX_REPLANS=2
MAX_ELEMENTS=80
MAX_PAGE_TEXT_CHARS=6000

# Vision
IMAGE_MAX_SIDE=768
IMAGE_JPEG_QUALITY=55
IMAGE_DETAIL=low
DEBUG_IMAGES=0                 # 1 = save every compressed screenshot to debug_images/

# Storage (falls back to in-memory if Redis is unreachable). Needs Redis Stack
# (RedisJSON + RediSearch) and langgraph-checkpoint-redis; set 0 otherwise.
USE_REDIS=1
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_MINUTES=30
