{
  "name": "script-redaction",
  "private": true,
  "type": "module",
  "description": "In-browser hybrid PII redaction engine (regex + checksum + NER)",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "setup:ner": "node scripts/fetch-model.mjs",
    "eval": "node test/eval.mjs",
    "eval:holdout": "node test/eval.mjs --corpus=holdout",
    "eval:baseline": "node test/eval.mjs --engine=legacy"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "compromise": "^14.14.0",
    "jsdom": "^25.0.1"
  }
}
